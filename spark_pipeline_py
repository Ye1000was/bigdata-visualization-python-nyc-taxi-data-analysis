        "from pyspark.sql import SparkSession\n",
        "\n",
        "def run_spark():\n",
        "    spark = SparkSession.builder.appName(\"Thesis\").getOrCreate()\n",
        "\n",
        "    df = spark.read.csv(\"data/data.csv\", header=True, inferSchema=True)\n",
        "\n",
        "    df = df.dropna()\n",
        "    df.describe().show()\n",
        "\n",
        "    df.write.mode(\"overwrite\").parquet(\"data/processed\")\n",
        "\n",
        "    spark.stop()"
